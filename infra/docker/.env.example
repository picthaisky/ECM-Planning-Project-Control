# infra/docker/.env.example
# Copy to infra/docker/.env (git-ignored) and fill in real values for local dev.
# NEVER commit the real .env - see docs/security/secrets-policy.md (P0-SEC-01).
# Every value consumed by infra/docker/docker-compose.yml is documented here (12-factor:
# no config is hardcoded in the compose file or baked into any image layer).

# ---------------------------------------------------------------------------
# api service
# ---------------------------------------------------------------------------
# ASP.NET Core hosting environment. Use "Production" to match the deployed topology;
# "Development" locally enables the OpenAPI/Swagger endpoint (see Program.cs).
ASPNETCORE_ENVIRONMENT=Production

# Host-side port the API is published on (container always listens on 8080 internally).
API_HOST_PORT=5000

# JWT signing key (S2-BE-01/S2-SEC-01). HMAC-SHA256 - must be long/high-entropy (>= 32 bytes);
# rotating it invalidates every issued token immediately. Never reused between dev/staging/prod
# (docs/security/secrets-policy.md).
JWT_SIGNING_KEY=Ch4ngeMe!JwtSigningKeyLocalDevOnly-please-use-32+chars
JWT_ISSUER=CMPlus
JWT_AUDIENCE=CMPlusClients
JWT_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# web service
# ---------------------------------------------------------------------------
# Host-side port the PWA is published on (container always listens on 8080 internally).
WEB_HOST_PORT=8081

# ---------------------------------------------------------------------------
# mssql service (see infra/docker/mssql/README.md for the authoritative reference -
# database-engineer owns these; names must stay identical here so .env is one source
# of truth across infra/docker/docker-compose.yml and infra/docker/mssql/docker-compose.mssql.yml)
# ---------------------------------------------------------------------------
# SQL Server edition inside the container. Developer is free/full-featured; never use it
# outside local dev.
MSSQL_PID=Developer

# sa password - must satisfy SQL Server's own complexity policy (>= 8 chars, 3 of:
# upper/lower/digit/symbol). Used only for local admin/bootstrap, never by the app.
MSSQL_SA_PASSWORD=Ch4ngeMe!LocalDevOnly

# Application database + dedicated least-privilege login (init/02-create-app-login.sql).
MSSQL_APP_DB=CMPlusDb
MSSQL_APP_USER=cmplus_app
MSSQL_APP_PASSWORD=Ch4ngeMe!AppLocalDevOnly

# Host port mapping; change if 1433 is already taken locally.
MSSQL_HOST_PORT=1433

# ---------------------------------------------------------------------------
# minio service (S3-compatible object storage - stands in for the AWS S3 vs Azure Blob
# decision deferred to the Sprint 16B gate, ADR-0010). Consumed by the api service's
# FileStorage__* settings, reserved for the Sprint 1+ IFileStorage adapter.
# ---------------------------------------------------------------------------
# Root credentials for the local MinIO instance - not a real AWS/Azure account, never
# reused outside local/dev/staging.
MINIO_ROOT_USER=cmplus_minio_admin
MINIO_ROOT_PASSWORD=Ch4ngeMe!MinioLocalDevOnly

# Bucket the API will read/write photos, attachments, and exports to or from.
MINIO_BUCKET=cmplus-files

# Host port mappings for the S3 API and the web console.
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# ---------------------------------------------------------------------------
# Image tagging (used by CI later, per S1-DO-01 / ADR-0010(b): images are tagged by
# commit SHA and pushed to an OCI registry - GHCR by default). Defaults to "local" for
# `docker compose build` on a developer machine.
# ---------------------------------------------------------------------------
IMAGE_TAG=local
