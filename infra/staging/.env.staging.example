# infra/staging/.env.staging.example — copy to infra/staging/.env and fill in.
# `.env` is git-ignored; only this example is committed. Never commit real secrets.

# --- Image to run (the exact CI-built tag) -----------------------------------------------
# CI (ci.yml) pushes ghcr.io/<owner>/cmplus/{api,web}:<git-sha> on merge to main.
IMAGE_REGISTRY=ghcr.io/<owner>/cmplus
IMAGE_TAG=<the-git-sha-to-promote>

# --- Public origin / TLS -----------------------------------------------------------------
# The hostname the proxy serves. `localhost` uses Caddy's internal CA (self-signed); a real
# public hostname with reachable :80/:443 lets Caddy fetch a real cert (see Caddyfile).
STAGING_DOMAIN=localhost

# --- Secrets (REQUIRED — no safe default) ------------------------------------------------
# >= 32 bytes of real entropy, unique per environment. Forging it forges any session.
JWT_SIGNING_KEY=
# SQL Server sa + least-privilege app login. Must satisfy SQL Server complexity (>=8 chars,
# 3 of upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=
MSSQL_APP_PASSWORD=

# --- Secrets (OPTIONAL in staging) -------------------------------------------------------
# EPPlus commercial licence — leave blank to run the non-commercial licence for functional
# testing in staging. REQUIRED before production (sprint-16.md).
EXCEL_COMMERCIAL_LICENSE_KEY=

# --- F-1: proxy network the api trusts for X-Forwarded-For -------------------------------
# The compose network subnet the `proxy` container sits on (e.g. 172.18.0.0/16). Find it after
# first `up` with:  docker network inspect staging_default -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
# Leaving it blank makes the api trust NO forwarded headers (safe default: per-IP limit falls back to
# the direct peer = the proxy, i.e. degraded but not spoofable) until the F-1 code fix reads it.
PROXY_KNOWN_NETWORK=

# --- Non-secret tunables (defaults are fine) ---------------------------------------------
JWT_ISSUER=CMPlus
JWT_AUDIENCE=CMPlusClients
MSSQL_APP_DB=CMPlusDb
MSSQL_APP_USER=cmplus_app
MSSQL_PID=Developer
MSSQL_HOST_PORT=1433
