<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- EF Core InMemory provider for DbContext-level tests (S1-BE-03/04) - no MSSQL container
         required for these. Sqlite was tried first but its provider has a documented gap:
         relational comparisons (<=, >=) on DateTimeOffset don't translate (its default string
         encoding isn't lexicographically sortable across offsets), which is exactly the
         ADR-0009 step-function predicate this suite exercises. InMemory evaluates LINQ natively
         with no such gap; SQL Server (the real target) has full native datetimeoffset comparison
         support, so this is purely a test-double choice, not a production concern. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.10" />
    <!-- S2-BE-01/03/07: end-to-end HTTP-level tests (login, JWT validation, ProblemDetails,
         Admin-only + cross-tenant 404) against the real WebApi host via WebApplicationFactory. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CMPlus.WebApi\CMPlus.WebApi.csproj" />
    <ProjectReference Include="..\..\src\CMPlus.Infrastructure\CMPlus.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\CMPlus.Application\CMPlus.Application.csproj" />
    <ProjectReference Include="..\..\src\CMPlus.Domain\CMPlus.Domain.csproj" />
  </ItemGroup>

</Project>